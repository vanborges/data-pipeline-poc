# Configuração local (nunca versionar)
.env

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Dados gerados pelo pipeline (o aluno os produz ao executar).
# As pastas do medallion ficam no repo (via .gitkeep); o CONTEÚDO é gerado.
# ATENÇÃO: data/fontes_poc/ É versionado — são as fontes da atividade.
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
data/*.duckdb
data/*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Logs e temporários
*.log
*.tmp

# Sistema operacional / IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Área local da professora (gabarito e ensaios) — NUNCA versionar
solucoes/

# Config local do Claude/editor
.claude/
